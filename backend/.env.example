# Env
# 运行环境：dev 开发环境，prod 生产环境
ENVIRONMENT='dev'

# Database
# 数据库名称（不是 PostgreSQL schema）；运行 fba init 前需先创建该数据库
DATABASE_SCHEMA='fba'
# 数据库类型：postgresql 或 mysql
DATABASE_TYPE='postgresql'
# 数据库服务器地址
DATABASE_HOST='127.0.0.1'
# 数据库端口：PostgreSQL 默认 5432，MySQL 默认 3306
DATABASE_PORT=5432
# 数据库连接用户名
DATABASE_USER='postgres'
# 数据库连接密码
DATABASE_PASSWORD='123456'
# 主键生成方式：snowflake 雪花 ID，autoincrement 自增 ID
DATABASE_PK_MODE='snowflake'
# 额外数据源
# DATABASE_SOURCES='{"read": "postgresql+asyncpg://user:password@host:5432/fba"}'
DATABASE_SOURCES='{}'

# Redis
# Redis 服务器地址
REDIS_HOST='127.0.0.1'
# Redis 服务端口
REDIS_PORT=6379
# Redis 连接密码；无密码时留空
REDIS_PASSWORD=''
# 应用使用的 Redis 数据库编号
REDIS_DATABASE=0

# CORS
# 允许跨域请求后端的前端地址，末尾不带斜杠，使用 JSON 数组
CORS_ALLOWED_ORIGINS='["http://127.0.0.1","http://127.0.0.1:5173","http://127.0.0.1:5777","http://localhost","http://localhost:5173","http://localhost:5777"]'

# Token
# Token 签名密钥；生产环境请使用随机密钥并妥善保管
TOKEN_SECRET_KEY='1VkVF75nsNABBjK_7-qz7GtzNy3AMvktc9TCPwKczCk'

# 访问 Token 有效期，单位秒（1 天）
TOKEN_EXPIRE_SECONDS=86400
# 刷新 Token 有效期，单位秒（7 天）
TOKEN_REFRESH_EXPIRE_SECONDS=604800
# 刷新 Token Cookie 有效期，单位秒（7 天）
COOKIE_REFRESH_TOKEN_EXPIRE_SECONDS=604800

# 登录
# 是否启用登录验证码；可能被后台动态配置覆盖
LOGIN_CAPTCHA_ENABLED=true
# 登录验证码有效期，单位秒（5 分钟）
LOGIN_CAPTCHA_EXPIRE_SECONDS=300

# 用户密码策略（可能被后台动态配置覆盖）
# 检查最近多少次历史密码
USER_PASSWORD_HISTORY_CHECK_COUNT=3
# 密码最小长度
USER_PASSWORD_MIN_LENGTH=6
# 密码最大长度
USER_PASSWORD_MAX_LENGTH=32
# 是否要求密码包含特殊字符
USER_PASSWORD_REQUIRE_SPECIAL_CHAR=false
# 密码有效天数；0 表示永不过期
USER_PASSWORD_EXPIRY_DAYS=0

# 文件上传
# 存储根目录，默认 storage；相对路径按仓库根目录解析，不存在时自动创建
# 生产部署可配置绝对路径，例如 /data/template/uploads
FILE_STORAGE_ROOT='storage'
# 上传文件分块读取大小，单位字节
UPLOAD_READ_SIZE=1048576
# 分片最大 4 MiB，与 Nginx 的 5 MiB 请求限制配合
FILE_UPLOAD_CHUNK_SIZE=4194304
# 上传会话空闲过期秒数及每用户未完成会话上限
FILE_UPLOAD_TTL_SECONDS=86400
FILE_UPLOAD_MAX_SESSIONS=10
# 各类型最大字节数，必须为正数且不超过 9007199254740991
FILE_UPLOAD_SIZE_LIMITS='{"file":1073741824,"avatar":5242880,"resource":2147483648,"document":536870912,"image":10485760,"audio":536870912,"video":1073741824}'
# 扩展名与 MIME 白名单；二进制文件同时使用 filetype 验证文件头
FILE_UPLOAD_ALLOWED_TYPES='{"jpg":["image/jpeg"],"jpeg":["image/jpeg"],"png":["image/png"],"gif":["image/gif"],"webp":["image/webp"],"bmp":["image/bmp"],"ico":["image/x-icon","image/vnd.microsoft.icon"],"pdf":["application/pdf"],"txt":["text/plain"],"md":["text/plain","text/markdown"],"csv":["text/plain","text/csv","application/vnd.ms-excel"],"json":["application/json","text/plain"],"docx":["application/vnd.openxmlformats-officedocument.wordprocessingml.document"],"xlsx":["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"],"pptx":["application/vnd.openxmlformats-officedocument.presentationml.presentation"],"zip":["application/zip","application/x-zip-compressed"],"7z":["application/x-7z-compressed"],"gz":["application/gzip","application/x-gzip"],"tar":["application/x-tar"],"rar":["application/x-rar-compressed","application/vnd.rar"],"mp3":["audio/mpeg"],"wav":["audio/x-wav","audio/wav"],"ogg":["audio/ogg","video/ogg","application/ogg"],"flac":["audio/x-flac","audio/flac"],"aac":["audio/aac"],"m4a":["audio/mp4","audio/x-m4a"],"mp4":["video/mp4"],"mov":["video/quicktime"],"avi":["video/x-msvideo"],"webm":["video/webm"],"mkv":["video/x-matroska"],"doc":["application/msword"],"xls":["application/vnd.ms-excel"],"ppt":["application/vnd.ms-powerpoint"],"yaml":["application/yaml","application/x-yaml","text/yaml","text/x-yaml","text/plain"],"yml":["application/yaml","application/x-yaml","text/yaml","text/x-yaml","text/plain"],"xml":["application/xml","text/xml","text/plain"],"html":["text/html","text/plain"],"css":["text/css","text/plain"],"js":["text/javascript","application/javascript","text/plain"],"py":["text/x-python","text/x-python-script","text/plain"],"java":["text/x-java-source","text/x-java","text/plain"]}'

# [ App ] task

# Celery
# Celery 使用 Redis 作为消息代理时的数据库编号
CELERY_BROKER_TYPE=redis
CELERY_BROKER_REDIS_DATABASE=1

# [ Plugin ] oauth2
# GitHub OAuth 应用的客户端 ID
OAUTH2_GITHUB_CLIENT_ID='test'
# GitHub OAuth 应用的客户端密钥
OAUTH2_GITHUB_CLIENT_SECRET='test'
# Google OAuth 应用的客户端 ID
OAUTH2_GOOGLE_CLIENT_ID='test'
# Google OAuth 应用的客户端密钥
OAUTH2_GOOGLE_CLIENT_SECRET='test'

# [ Plugin ] email
# SMTP 登录账号，同时作为发件人邮箱
EMAIL_USERNAME=''
# SMTP 登录密码或邮箱授权码
EMAIL_PASSWORD=''
# 软删除数据保留天数及每批物理删除条数
SOFT_DELETE_RETENTION_DAYS=30
SOFT_DELETE_CLEANUP_BATCH_SIZE=500

# [ Plugin ] opensandbox
OPEN_SANDBOX_ENABLED='false'
OPEN_SANDBOX_URL='http://127.0.0.1:8080'
OPEN_SANDBOX_API_KEY=''
OPEN_SANDBOX_SERVICE_START_COMMAND=''
OPEN_SANDBOX_SERVICE_STOP_COMMAND=''
